{
  "name": "git9",
  "version": "0.3.0",
  "description": "Utilities for Git",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint --fix './**/*.{js,ts}'",
    "prepack": "tsdown",
    "test": "vitest",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyanSalt/git9.git"
  },
  "keywords": [
    "git"
  ],
  "author": "CyanSalt",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CyanSalt/git9/issues"
  },
  "homepage": "https://github.com/CyanSalt/git9#readme",
  "devDependencies": {
    "@cyansalt/eslint-config": "^4.5.0",
    "@cyansalt/tsconfig": "^3.0.2",
    "@release-it/conventional-changelog": "^10.0.6",
    "@types/node": "^22.19.17",
    "@types/tar-stream": "^3.1.4",
    "eslint": "^9.39.4",
    "release-it": "^19.2.4",
    "tsdown": "^0.21.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "quansync": "^1.0.0",
    "tar-stream": "^3.1.8"
  }
}
